    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tauri-apps/cli": "^2.11.5",
        "@types/node": "^24.13.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.10.0",
        "eslint-plugin-svelte": "^3.23.0",
